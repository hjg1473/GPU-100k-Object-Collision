[numthreads(64,1,1)]
void ClearCellCounts(uint3 id : SV_DispatchThreadID)
{
    uint cellIndex = id.x;
    uint cellRange = _GridSize * _GridSize * _GridSize;

    if (cellIndex >= cellRange) return;

    _CellCounts[cellIndex] = 0;
}

[numthreads(64,1,1)]
void ClearCellWriteCounters(uint3 id : SV_DispatchThreadID)
{
    uint cellIndex = id.x;
    uint cellRange = _GridSize * _GridSize * _GridSize;

    if (cellIndex >= cellRange) return;

    _CellWriteCounters[cellIndex] = 0;
}

[numthreads(64,1,1)]
void UpdateCellCounts(uint3 id : SV_DispatchThreadID)
{
    uint objectID = id.x;

    if (objectID >= _Count) return;
    
    float3 pos = _Positions[objectID];
    int3 cell = ConvertCell(pos);

    if (!IsValidCell(cell)) return;

    uint cellIndex = CellToIndex(cell);

    InterlockedAdd(_CellCounts[cellIndex], 1);
}

[numthreads(64,1,1)]
void UpdateObjectIDs(uint3 id : SV_DispatchThreadID)
{
    uint objectID = id.x;
    if (objectID >= _Count) return;

    float3 pos = _Positions[objectID];

    int3 cell = ConvertCell(pos);
    
    if (!IsValidCell(cell)) return;

    uint cellIndex = CellToIndex(cell);

    uint localIdx;
    InterlockedAdd(_CellWriteCounters[cellIndex], 1, localIdx);

    uint idx = _CellStarts[cellIndex] + localIdx; 

    _ObjectIDs[idx] = objectID;
}

[numthreads(64,1,1)]
void UpdateCellStarts(uint3 id : SV_DispatchThreadID)
{
    uint cellIndex = id.x;
    uint cellRange = _GridSize * _GridSize * _GridSize;

    if (cellIndex >= cellRange) return;

    uint value = _PrefixInput[cellIndex];

    if (cellIndex >= _Offset)
        value += _PrefixInput[cellIndex - _Offset]; // 자기 자신 + offset만큼 앞의 거를 더함.
    
    _PrefixOutput[cellIndex] = value;
}

[numthreads(64,1,1)]
void InclusiveToExclusive(uint3 id : SV_DispatchThreadID)
{
    uint cellIndex = id.x;
    uint cellRange = _GridSize * _GridSize * _GridSize;

    if (cellIndex >= cellRange) return;
    
    if (cellIndex == 0) _CellStarts[0] = 0;
    else _CellStarts[cellIndex] = _PrefixInput[cellIndex-1];
}

[numthreads(64,1,1)]
void ApplyGravity(uint3 id : SV_DispatchThreadID)
{
    uint objectID = id.x;
    
    if (objectID >= _Count) return;
    
    float3 pos = _Positions[objectID];
    float3 velocity = _Velocities[objectID];
    velocity += float3(0, -9.81f, 0) * _DeltaTime;

    velocity = ResolveBoundaryVelocity(pos, velocity);

    _NextVelocities[objectID] = velocity;
}

[numthreads(64,1,1)]
void BuildContacts(uint3 id : SV_DispatchThreadID)
{
    uint myID = id.x;
    if (myID >= _Count) return;

    float3 myPos = _Positions[myID];
    float4 myRot = _Rotations[myID];

    int3 myCell = ConvertCell(myPos);

    if (!IsValidCell(myCell)) return;

    // ---------- Broad Phase ----------
    for (int x = -1; x <= 1; x++)
    for (int y = -1; y <= 1; y++) 
    for (int z = -1; z <= 1; z++) 
    {        
        int3 otherCell = myCell + int3(x, y, z);                

        if (!IsValidCell(otherCell)) continue;
        
        uint otherCellIndex = CellToIndex(otherCell);

        uint cnt = _CellCounts[otherCellIndex];
        uint start = _CellStarts[otherCellIndex];

        for (uint k = start; k < start + cnt; k++)
        {
            uint otherID = _ObjectIDs[k];  

            if (otherID <= myID) continue;

            float3 otherPos = _Positions[otherID];
            float4 otherRot = _Rotations[otherID];
            // ---------- Narrow Phase ----------
            Contact contact = Narrow_Phase(myPos, otherPos, myRot, otherRot);
            
            if (!contact.hit || contact.pointCount == 0) continue;
        
            uint baseIndex;
            InterlockedAdd(_ContactCount[0], contact.pointCount, baseIndex);

            for (uint p = 0; p < contact.pointCount; p++)
            {
                uint index = baseIndex + p;

                if (index >= _MaxContacts) continue;

                ContactConstraint constraint;

                constraint.bodyA = myID;
                constraint.bodyB = otherID;

                constraint.p = contact.points[p].pos;
                constraint.normal = contact.normal;

                constraint.penetration = contact.points[p].penetration;

                constraint.accumulatedNormalImpulse = 0.0f;

                _ContactConstraints[index] = constraint;
            }        
        }
    }
}

[numthreads(64,1,1)]
void ClearContactHeads(uint3 id : SV_DispatchThreadID)
{
    uint objectID = id.x;
    if (objectID >= _Count) return;

    _BodyContactHeads[objectID] = 0xFFFFFFFFu;
}

[numthreads(64,1,1)]
void BuildContactLinks(uint3 id : SV_DispatchThreadID)
{
    uint contactID = id.x;

    uint contactCount = min(_ContactCount[0], _MaxContacts);

    if (contactID >= contactCount) return;

    ContactConstraint c = _ContactConstraints[contactID];

    uint previousA;
    InterlockedExchange(_BodyContactHeads[c.bodyA], contactID, previousA);

    _ContactNextA[contactID] = previousA;

    if (c.bodyB == FLOOR_BODY)
    {
        _ContactNextB[contactID] = 0xFFFFFFFFu;    
        return;
    }

    uint previousB;
    InterlockedExchange(_BodyContactHeads[c.bodyB], contactID, previousB);

    _ContactNextB[contactID] = previousB;
}

[numthreads(64,1,1)]
void SolveContactImpulses(uint3 id : SV_DispatchThreadID)
{
    uint contactID = id.x;

    uint contactCount = min(_ContactCount[0], _MaxContacts);

    if (contactID >= contactCount) return;

    ContactConstraint c = _ContactConstraints[contactID];

    bool isFloor = (c.bodyB == FLOOR_BODY);

    uint bodyA = c.bodyA;
    uint bodyB = c.bodyB;

    float3 posA = _Positions[bodyA];
    float3 velA = _Velocities[bodyA];
    float3 angA = _AngularVelocities[bodyA];

    float3 posB = float3(0,0,0);
    float3 velB = float3(0,0,0);
    float3 angB = float3(0,0,0);

    if (!isFloor)
    {
        posB = _Positions[bodyB];
        velB = _Velocities[bodyB];
        angB = _AngularVelocities[bodyB];
    }

    float3 rA = c.p - posA;
    float3 rB = isFloor ? float3(0,0,0) : c.p - posB;

    float invMassA = 1.0f;
    float invMassB = isFloor ? 0.0f : 1.0f;

    float invInertiaA = 6.0f;
    float invInertiaB = isFloor ? 0.0f : 6.0f;

    float3 velocityA = velA + cross(angA, rA);
    float3 velocityB = velB + cross(angB, rB);

    float vn = dot(velocityB - velocityA, c.normal);

    float3 rnA = cross(rA, c.normal);
    float3 rnB = cross(rB, c.normal);

    float K = invMassA + invMassB + invInertiaA * dot(rnA, rnA) + invInertiaB * dot(rnB, rnB);

    float slop = 0.005f;
    float beta = 0.05f;

    float penetrationError = max(c.penetration - slop, 0.0f);
    float bias = beta * penetrationError / max(_DeltaTime, 1e-6f);
    // bias = min(bias, 0.5f);

    float oldLambda = c.accumulatedNormalImpulse;
    float deltaLambda = (-vn + bias) / max(K, 1e-6f);
    float newLambda = max(oldLambda + deltaLambda, 0.0f);
    
    float relaxation = 0.25f;
    newLambda = max(oldLambda + relaxation * deltaLambda, 0.0f);

    deltaLambda = newLambda - oldLambda;

    c.accumulatedNormalImpulse = newLambda;
    _ContactConstraints[contactID] = c;
    _ContactDeltaImpulses[contactID] = deltaLambda;
}

[numthreads(64,1,1)]
void ApplyContactImpulses(uint3 id : SV_DispatchThreadID)
{
    uint bodyID = id.x;

    if (bodyID >= _Count) return;

    float3 pos = _Positions[bodyID];
    float3 velocity = _Velocities[bodyID];
    float3 angularVelocity = _AngularVelocities[bodyID];

    float3 deltaVelocity = float3(0,0,0);
    float3 deltaAngularVelocity = float3(0,0,0);

    uint contactID = _BodyContactHeads[bodyID];

    while (contactID != 0xFFFFFFFFu)
    {
        ContactConstraint c = _ContactConstraints[contactID];

        float deltaLambda = _ContactDeltaImpulses[contactID];

        float3 impulse = deltaLambda * c.normal;

        bool isA = (c.bodyA == bodyID);

        if (isA) impulse = -impulse;

        float3 r = c.p - pos;

        deltaVelocity += impulse;
        deltaAngularVelocity += 6.0f * cross(r, impulse);

        contactID = isA ? _ContactNextA[contactID] : _ContactNextB[contactID];
    }

    _NextVelocities[bodyID] = velocity + deltaVelocity;
    _NextAngularVelocities[bodyID] = angularVelocity + deltaAngularVelocity;
}

[numthreads(64, 1, 1)]
void BuildFloorContacts(uint3 id : SV_DispatchThreadID)
{
    uint objectID = id.x;
    if (objectID >= _Count) return;

    float3 pos = _Positions[objectID];
    float4 q = _Rotations[objectID];

    float floorY = _WorldMin.y;

    float3 sumPoint = float3(0,0,0);
    float maxPenetration = 0.0f;
    uint hitCount = 0;

    [unroll]
    for (uint i = 0; i<8; i++)
    {
        float3 localVertex = float3(
            (i & 1u) ? 0.5f : -0.5f,
            (i & 2u) ? 0.5f : -0.5f,
            (i & 4u) ? 0.5f : -0.5f
        );

        float3 r = RotateByQuaternion(localVertex, q);
        float3 worldVertex = pos + r;

        float penetration = floorY - worldVertex.y;

        if (penetration >= -0.005f)
        {
            sumPoint += worldVertex;
            hitCount++;

            maxPenetration = max(maxPenetration, penetration);
        }
    }

    if (hitCount == 0) return;

    uint contactID; 
    InterlockedAdd(_ContactCount[0], 1, contactID);

    if (contactID >= _MaxContacts) return;

    ContactConstraint c;

    c.bodyA = objectID;
    c.bodyB = FLOOR_BODY;

    c.p = sumPoint / hitCount;
    c.normal = float3(0.0f, -1.0f, 0.0f);
    c.penetration = maxPenetration;
    c.accumulatedNormalImpulse = 0.0f;

    _ContactConstraints[contactID] = c;
}


[numthreads(64,1,1)]
void main (uint3 id : SV_DispatchThreadID)
{    
    uint objectID = id.x;

    if (objectID >= _Count) return;

    // Rigidbody
    // _Positions[objectID] += _Velocities[objectID] * _DeltaTime;
    float3 pos = _Positions[objectID];
    pos += _Velocities[objectID] * _DeltaTime;
    _Positions[objectID] = pos;

    float4 rotation = _Rotations[objectID];
    float3 angularVelocity = _AngularVelocities[objectID];
    _Rotations[objectID] = IntegrateRotation(rotation, angularVelocity, _DeltaTime);
}
