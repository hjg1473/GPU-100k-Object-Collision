#pragma kernel InitializeBodies
#pragma kernel ClearGrid
#pragma kernel UpdateCellCounts
#pragma kernel UpdateObjectIDs
#pragma kernel ScanBlocks
#pragma kernel AddBlockOffsets
#pragma kernel ResetCounters
#pragma kernel FinalizeContacts
#pragma kernel ApplyGravity
#pragma kernel ClearContactHeads
#pragma kernel BuildContactLinks
#pragma kernel SolveContactImpulses
#pragma kernel ApplyContactImpulses
#pragma kernel BuildContacts
#pragma kernel BuildFloorContacts
#pragma kernel main

// Equal unit cubes: inverse mass = 1, isotropic inverse inertia = 6.
// All contact normals point A -> B (outward for a static boundary).
struct ContactConstraint
{
    uint bodyA;
    uint bodyB;
    float3 p;
    float3 normal;
    float penetration;
    float accumulatedNormalImpulse;
    float3 accumulatedTangentImpulse;
    float targetVelocity;
};
struct ContactPoint { float3 pos; float penetration; };
struct Contact { bool hit; float3 normal; float penetration; ContactPoint points[8]; uint pointCount; };
struct AxisResult { bool separated; float overlap; };

float _DeltaTime, _CellSize, _Friction, _Restitution, _LinearDamping, _AngularDamping;
float3 _WorldMin;
uint _Count, _GridSize, _MaxContacts, _ScanLength, _SolverIteration, _SpawnWidth;
static const uint FLOOR_BODY = 0xFFFFFFFFu;
RWStructuredBuffer<uint> _CellCounts, _ObjectIDs, _CellStarts, _CellWriteCounters;
StructuredBuffer<uint> _PrefixInput, _BlockOffsets;
RWStructuredBuffer<uint> _PrefixOutput, _BlockSums;
RWStructuredBuffer<float3> _Positions;
RWStructuredBuffer<float4> _Rotations;
StructuredBuffer<float3> _Velocities, _AngularVelocities;
RWStructuredBuffer<float3> _NextVelocities, _NextAngularVelocities;
RWStructuredBuffer<ContactConstraint> _ContactConstraints;
// requested contacts, maximum cell occupancy, boundary projections, invalid bodies
RWStructuredBuffer<uint> _ContactCount;
RWStructuredBuffer<float3> _ContactDeltaImpulses;
RWStructuredBuffer<uint> _BodyContactHeads, _BodyContactCounts, _ContactNextA, _ContactNextB;
RWByteAddressBuffer _DispatchArgs;
StructuredBuffer<ContactConstraint> _ReadContacts;
StructuredBuffer<uint> _ReadHeads, _ReadNextA, _ReadNextB;
groupshared uint scanValues[256];

int3 ConvertCell(float3 pos) { return (int3)floor((pos - _WorldMin) / _CellSize); }
uint CellToIndex(int3 cell) { return cell.x + cell.y * _GridSize + cell.z * _GridSize * _GridSize; }
bool IsValidCell(int3 c) { return all(c >= 0) && all(c < (int)_GridSize); }
float3 RotateByQuaternion(float3 v, float4 q)
{
    return v + 2.0f * q.w * cross(q.xyz, v) + 2.0f * cross(q.xyz, cross(q.xyz, v));
}
uint Hash(uint x)
{
    x ^= x >> 16; x *= 0x7feb352du; x ^= x >> 15; x *= 0x846ca68bu; return x ^ (x >> 16);
}
float Random01(uint seed) { return (Hash(seed) & 0x00ffffffu) / 16777216.0f; }
void GetFaceVertices(float3 center, float3 axes[3], float3 halfExtents, int axisIndex, float faceSign, out float3 vertices[4])
{
    int u = ((uint)axisIndex + 1u) % 3u;
    int v = ((uint)axisIndex + 2u) % 3u;

    float3 faceCenter = center + axes[axisIndex] * halfExtents[axisIndex] * faceSign;

    float3 U = axes[u] * halfExtents[u];
    float3 V = axes[v] * halfExtents[v];

    vertices[0] = faceCenter - U - V;
    vertices[1] = faceCenter + U - V;
    vertices[2] = faceCenter + U + V;
    vertices[3] = faceCenter - U + V;
}

void ClipPolygonAgainstPlane(
    float3 inputVertices[8], uint inputCount,
    float3 planePoint, float3 planeNormal,
    out float3 outputVertices[8], out uint outputCount
)
{
    outputCount = 0;
    // 다각형의 모서리를 하나씩 순회한다.
    //    P0 → P1, P1 → P2, ... 마지막 → 처음
    for (uint edge = 0; edge < inputCount; edge++)
    {
        float3 S = inputVertices[edge];
        float3 E = inputVertices[(edge+1) % inputCount];
        // 각 모서리의 시작점 S와 끝점 E가
        //    경계 안쪽인지 바깥쪽인지 판단한다.
        float3 relativeS = planePoint - S;
        float3 relativeE = planePoint - E;

        float distS = dot(relativeS, planeNormal);
        float distE = dot(relativeE, planeNormal);

        bool insideS = distS >= 0.0f;
        bool insideE = distE >= 0.0f;

        // 네 가지 경우에 따라 처리한다.
        //    안 → 안 : E 추가
        //    안 → 밖 : 교차점 추가
        //    밖 → 안 : 교차점, E 추가
        //    밖 → 밖 : 추가하지 않음
        if (insideS && insideE)
        {
            outputVertices[outputCount++] = E;
        }
        else if (insideS && !insideE)
        {
            float t = distS / (distS - distE);
            float3 I = lerp(S, E, t);

            outputVertices[outputCount++] = I;
        }
        else if (!insideS && insideE)
        {
            float t = distS / (distS - distE);
            float3 I = lerp(S, E, t);

            outputVertices[outputCount++] = I;
            outputVertices[outputCount++] = E;
        }
    }
}

void GenerateFaceContacts(
    float3 posA, float3 posB,
    float3 A[3], float3 B[3], 
    float3 normal, int minAxisIndex,
    out ContactPoint contacts[8], out uint contactCount)
{
    contactCount = 0;

    bool refIsA = minAxisIndex < 3;

    int refAxisIndex = refIsA ? minAxisIndex : minAxisIndex - 3;

    float3 refNormal = refIsA ? normal : -normal;

    float3 refAxis = refIsA ? A[refAxisIndex] : B[refAxisIndex];

    float refSign = dot(refAxis, refNormal) >= 0.0f ? 1.0f : -1.0f;

    float3 refCenter = refIsA ? posA : posB;

    float3 refFaceCenter = refCenter + refAxis * 0.5f * refSign;

    // Incident Face vertices 구하기. = Clipping Input Vertices
    float3 incidentVertices[8];
    uint incidentCount;

    [unroll]
    for (int vertexIndex = 0; vertexIndex < 8; vertexIndex++)
    {
        incidentVertices[vertexIndex] = float3(0.0f, 0.0f, 0.0f);
    }

    float3 incCenter = refIsA ? posB : posA;
    float3 incAxes[3];

    for (int copyAxis = 0; copyAxis < 3; copyAxis++)
    {
        incAxes[copyAxis] = refIsA ? B[copyAxis] : A[copyAxis];
    }

    int incAxisIndex = 0;
    float maxDot = -1.0f; // ref, inc dot 최대값

    for (int candidateAxis = 0; candidateAxis < 3; candidateAxis++)
    {
        float d = abs(dot(incAxes[candidateAxis], refNormal));

        if (d > maxDot)
        {
            maxDot = d;
            incAxisIndex = candidateAxis;
        }
    }

    float d = dot(incAxes[incAxisIndex], refNormal);
    float incSign = d > 0.0f ? -1.0f : 1.0f;

    float3 incFaceCenter = incCenter + incAxes[incAxisIndex] * 0.5f * incSign;
    
    int incUIndex = ((uint)incAxisIndex + 1u) % 3u;
    int incVIndex = ((uint)incAxisIndex + 2u) % 3u;

    float3 incU = incAxes[incUIndex] * 0.5f;
    float3 incV = incAxes[incVIndex] * 0.5f;

    incidentVertices[0] = incFaceCenter - incU - incV;
    incidentVertices[1] = incFaceCenter + incU - incV;
    incidentVertices[2] = incFaceCenter + incU + incV;
    incidentVertices[3] = incFaceCenter - incU + incV;

    incidentCount = 4;


    // 경계 평면의 point, noraml 구하기. = planePoint, planeNormal
    float3 U; float3 V;
    if (refIsA) 
    {
        U = A[((uint)refAxisIndex + 1u) % 3u];
        V = A[((uint)refAxisIndex + 2u) % 3u];
    }
    else 
    {
        U = B[((uint)refAxisIndex + 1u) % 3u];
        V = B[((uint)refAxisIndex + 2u) % 3u];
    }
    
    // Clip 하기
    float3 clippedVertices[8];
    uint clippedCount = 0;

    ClipPolygonAgainstPlane(incidentVertices, incidentCount, refFaceCenter + U * 0.5f, U, clippedVertices, clippedCount);
    ClipPolygonAgainstPlane(clippedVertices, clippedCount, refFaceCenter - U * 0.5f, -U, incidentVertices, incidentCount);
    ClipPolygonAgainstPlane(incidentVertices, incidentCount, refFaceCenter + V * 0.5f, V, clippedVertices, clippedCount);
    ClipPolygonAgainstPlane(clippedVertices, clippedCount, refFaceCenter - V * 0.5f, -V, incidentVertices, incidentCount);

    // penetration 계산
    for (uint pointIndex = 0; pointIndex < incidentCount; pointIndex++)
    {
        float3 contactPos = incidentVertices[pointIndex];

        float distance = dot(contactPos - refFaceCenter, refNormal);

        if (distance <= 0.0f) {
            contacts[contactCount].pos = contactPos - 0.5f * distance * refNormal;
            contacts[contactCount].penetration = -distance;
            contactCount++;
        }
    }
}

float3 ClosestPointOnSegment(float3 queryPos, float3 segmentStart, float3 segmentEnd)
{
    float3 direction = segmentEnd - segmentStart;

    float t = dot(queryPos - segmentStart, direction)
            / dot(direction, direction);

    t = saturate(t);

    return segmentStart + t * direction;
}

void UpdateClosestPair(
    float3 pA, float3 pB,
    inout float minDistSq, inout float3 closestA, inout float3 closestB)
{
    float3 diff = pA - pB;
    float distSq = dot(diff, diff);

    if (distSq < minDistSq)
    {
        minDistSq = distSq;
        closestA = pA;
        closestB = pB;
    }
}

void ClosestPointsOnLines(
    float3 a0, float3 a1, float3 b0, float3 b1,
    out float3 closestA, out float3 closestB)
{
    float3 u = a1 - a0;
    float3 v = b1 - b0;
    float3 w = a0 - b0;

    float a = dot(u, u);
    float b = dot(u, v);
    float c = dot(v, v);
    float d = dot(u, w);
    float e = dot(v, w);

    float denominator = a * c - b * b;

    // 그리고 closestA, closestB 계산
    if (denominator > 1e-8f)
    {
        float s = (b * e - c * d) / denominator;
        float t = (a * e - b * d) / denominator;

        if (s >= 0.0f && s <= 1.0f &&
            t >= 0.0f && t <= 1.0f)
        {
            closestA = a0 + s * u;
            closestB = b0 + t * v;
            return;
        }
    }
        
    closestA = a0; closestB = b0;
    float minDistSq = 1e30f;

    UpdateClosestPair(a0, ClosestPointOnSegment(a0, b0, b1), minDistSq, closestA, closestB);
    UpdateClosestPair(a1, ClosestPointOnSegment(a1, b0, b1), minDistSq, closestA, closestB);
    UpdateClosestPair(ClosestPointOnSegment(b0, a0, a1), b0, minDistSq, closestA, closestB);
    UpdateClosestPair(ClosestPointOnSegment(b1, a0, a1), b1, minDistSq, closestA, closestB);
}

void GenerateEdgeContact(
    float3 posA, float3 posB,
    float3 A[3], float3 B[3], 
    float3 normal, int minAxisIndex, float penetration,
    out ContactPoint contactPoint)
{
    
    uint edgeIndex = (uint)(minAxisIndex - 6);
    uint axisAIndex = edgeIndex / 3u;
    uint axisBIndex = edgeIndex % 3u; // 축 선택

    // 1. A의 실제 모서리 선택
    int aU = ((uint)axisAIndex + 1u) % 3u;
    int aV = ((uint)axisAIndex + 2u) % 3u;
    float signAU = dot(A[aU], normal) >= 0.0f ? 1.0f : -1.0f;
    float signAV = dot(A[aV], normal) >= 0.0f ? 1.0f : -1.0f;

    float3 edgeCenterA = posA + A[aU] * 0.5f * signAU + A[aV] * 0.5f * signAV;

    // 2. B의 실제 모서리 선택
    int bU = ((uint)axisBIndex + 1u) % 3u;
    int bV = ((uint)axisBIndex + 2u) % 3u;
    float signBU = dot(B[bU], -normal) >= 0.0f ? 1.0f : -1.0f;
    float signBV = dot(B[bV], -normal) >= 0.0f ? 1.0f : -1.0f;

    float3 edgeCenterB = posB + B[bU] * 0.5f * signBU + B[bV] * 0.5f * signBV;
    
    // 3. 각 모서리의 양 끝점 구하기
    float3 a0 = edgeCenterA - 0.5f * A[axisAIndex];
    float3 a1 = edgeCenterA + 0.5f * A[axisAIndex];

    float3 b0 = edgeCenterB - 0.5f * B[axisBIndex];
    float3 b1 = edgeCenterB + 0.5f * B[axisBIndex];
    // 4. 두 선분의 최근접점 계산
    float3 closestA; float3 closestB;
    ClosestPointsOnLines(a0, a1, b0, b1, closestA, closestB);

    // 5. ContactPoint 생성
    contactPoint.pos = (closestA + closestB) * 0.5f;
    contactPoint.penetration = penetration;
}

AxisResult TestAxis(float3 axis, 
    float3 posA, float3 posB,
    float3 Ax, float3 Ay, float3 Az, 
    float3 Bx, float3 By, float3 Bz,
    float3 halfA, float3 halfB)
{
    AxisResult result;

    axis = normalize(axis);
    // axis로 투영.
    float centerA = dot(posA, axis);
    float rA = halfA.x * abs(dot(Ax, axis)) +
               halfA.y * abs(dot(Ay, axis)) +
               halfA.z * abs(dot(Az, axis));

    float centerB = dot(posB, axis);
    float rB = halfB.x * abs(dot(Bx, axis)) +
               halfB.y * abs(dot(By, axis)) +
               halfB.z * abs(dot(Bz, axis));

    float distance = abs(dot(posB - posA, axis));

    result.overlap = (rA + rB) - distance;
    result.separated = result.overlap < 0.0f;    

    return result;
}

// OBB vs OBB SAT
Contact Narrow_Phase(float3 posA, float3 posB, float4 rotA, float4 rotB)
{
    Contact contact;

    contact.hit = false;
    contact.normal = 0;
    contact.penetration = 0;
    contact.pointCount = 0;    

    for (uint resetPoint = 0; resetPoint < 8; resetPoint++)
    {
        contact.points[resetPoint].pos = float3(0,0,0);
        contact.points[resetPoint].penetration = 0.0f;
    }

    float3 axes[15];
    // OBB : face normal
    float3 A[3];
    A[0] = RotateByQuaternion(float3(1,0,0), rotA);
    A[1] = RotateByQuaternion(float3(0,1,0), rotA);
    A[2] = RotateByQuaternion(float3(0,0,1), rotA);
    
    float3 B[3];
    B[0] = RotateByQuaternion(float3(1,0,0), rotB);
    B[1] = RotateByQuaternion(float3(0,1,0), rotB);
    B[2] = RotateByQuaternion(float3(0,0,1), rotB);
    // edges
    axes[0] = A[0]; axes[1] = A[1]; axes[2] = A[2];
    axes[3] = B[0]; axes[4] = B[1]; axes[5] = B[2];

    int index = 6;
    for (int axisA=0; axisA<3; axisA++)
    for (int j=0; j<3; j++)
    {
        axes[index++] = cross(A[axisA], B[j]);
    }

    // 분리축 찾기
    float minOverlap = 1e30;
    float3 minAxis = 0; // 접촉 축 방향
    int minAxisIndex = -1; // 어떤 축에서 접촉했는지

    float3 halfA = float3(0.5f, 0.5f, 0.5f);
    float3 halfB = float3(0.5f, 0.5f, 0.5f);

    for (int axisIndex=0; axisIndex<15; axisIndex++)
    {
        float3 axis = axes[axisIndex];

        if (dot(axis, axis) < 1e-8f) continue;

        AxisResult result = TestAxis(axis, posA, posB, A[0], A[1], A[2], B[0], B[1], B[2], halfA, halfB);

        if (result.separated)
        {
            contact.hit = false; // 충돌 안함
            return contact; 
        }

        if (result.overlap < minOverlap - (axisIndex >= 6 ? 0.001f : 0.0f))
        {
            minOverlap = result.overlap;
            minAxis = normalize(axis);
            minAxisIndex = axisIndex;
        }

    }
    
    if (dot(minAxis, posB - posA) < 0.0f) minAxis = -minAxis;
    
    contact.hit = true;
    contact.penetration = minOverlap;
    contact.normal = minAxis;

    if (minAxisIndex < 6) 
    {
        GenerateFaceContacts(posA, posB, A, B, minAxis, minAxisIndex, contact.points, contact.pointCount);
    }
    else 
    {
        GenerateEdgeContact(posA, posB, A, B, minAxis, minAxisIndex, minOverlap, contact.points[0]);
        contact.pointCount = 1;
    }
    
    return contact;
}

float4 IntegrateRotation(float4 rotation, float3 angularVelocity, float dt)
{
    float spd = length(angularVelocity); // rad/s

    if (spd < 1e-6f) return rotation;

    float angle = spd * dt;
    float3 axis = angularVelocity / spd;

    float halfAngle = angle * 0.5f;

    float s, c;
    sincos(halfAngle, s, c);

    float4 deltaRotation = float4(axis * s, c);
    float4 q = deltaRotation;
    float4 r = rotation;

    float4 result;
    result.xyz = q.w * r.xyz + r.w * q.xyz + cross(q.xyz, r.xyz);
    result.w = q.w * r.w - dot(q.xyz, r.xyz);

    return normalize(result);
}

[numthreads(64,1,1)]
void InitializeBodies(uint3 id : SV_DispatchThreadID)
{
    uint i = id.x;
    if (i >= _Count) return;
    uint width = _SpawnWidth;
    uint x = i % width, y = (i / width) % width, z = i / (width * width);
    float margin = (_GridSize * _CellSize - (width - 1) * 1.15f) * 0.5f;
    _Positions[i] = _WorldMin + float3(margin + x * 1.15f, 2.0f + y * 1.15f, margin + z * 1.15f);
    float yaw = (Random01(i + 19u) - 0.5f) * 0.16f;
    _Rotations[i] = float4(0, sin(yaw * 0.5f), 0, cos(yaw * 0.5f));
    _NextVelocities[i] = float3(Random01(i + 23u) - 0.5f, 0, Random01(i + 47u) - 0.5f) * 0.1f;
    _NextAngularVelocities[i] = 0;
}

[numthreads(1,1,1)]
void ResetCounters(uint3 id : SV_DispatchThreadID)
{
    _ContactCount[0] = 0; _ContactCount[1] = 0; _ContactCount[2] = 0; _ContactCount[3] = 0;
}

[numthreads(64,1,1)]
void ClearGrid(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _GridSize * _GridSize * _GridSize) return;
    _CellCounts[id.x] = 0;
    _CellWriteCounters[id.x] = 0;
}

[numthreads(64,1,1)]
void UpdateCellCounts(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _Count) return;
    int3 cell = ConvertCell(_Positions[id.x]);
    if (!IsValidCell(cell)) return;
    uint oldCount;
    InterlockedAdd(_CellCounts[CellToIndex(cell)], 1, oldCount);
    InterlockedMax(_ContactCount[1], oldCount + 1);
}

// Work-efficient exclusive Blelloch scan. Every lane participates, including the padded tail.
[numthreads(256,1,1)]
void ScanBlocks(uint3 group : SV_GroupID, uint lane : SV_GroupIndex)
{
    uint index = group.x * 256u + lane;
    scanValues[lane] = index < _ScanLength ? _PrefixInput[index] : 0;
    GroupMemoryBarrierWithGroupSync();
    for (uint upStride = 1; upStride < 256; upStride <<= 1)
    {
        uint k = (lane + 1) * upStride * 2 - 1;
        if (k < 256) scanValues[k] += scanValues[k - upStride];
        GroupMemoryBarrierWithGroupSync();
    }
    if (lane == 0)
    {
        _BlockSums[group.x] = scanValues[255];
        scanValues[255] = 0;
    }
    GroupMemoryBarrierWithGroupSync();
    for (uint downStride = 128; downStride > 0; downStride >>= 1)
    {
        uint k = (lane + 1) * downStride * 2 - 1;
        if (k < 256)
        {
            uint left = scanValues[k - downStride];
            scanValues[k - downStride] = scanValues[k];
            scanValues[k] += left;
        }
        GroupMemoryBarrierWithGroupSync();
    }
    if (index < _ScanLength) _PrefixOutput[index] = scanValues[lane];
}

[numthreads(256,1,1)]
void AddBlockOffsets(uint3 id : SV_DispatchThreadID)
{
    if (id.x < _ScanLength) _PrefixOutput[id.x] += _BlockOffsets[id.x / 256];
}

[numthreads(64,1,1)]
void UpdateObjectIDs(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _Count) return;
    int3 cell = ConvertCell(_Positions[id.x]);
    if (!IsValidCell(cell)) return;
    uint cellIndex = CellToIndex(cell), offset;
    InterlockedAdd(_CellWriteCounters[cellIndex], 1, offset);
    _ObjectIDs[_CellStarts[cellIndex] + offset] = id.x;
}

[numthreads(64,1,1)]
void ApplyGravity(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _Count) return;
    _NextVelocities[id.x] = (_Velocities[id.x] + float3(0, -9.81f, 0) * _DeltaTime) / (1 + _LinearDamping * _DeltaTime);
}

void AppendContact(uint a, uint b, float3 p, float3 normal, float penetration)
{
    uint index;
    InterlockedAdd(_ContactCount[0], 1, index);
    if (index >= _MaxContacts) return;
    ContactConstraint c = (ContactConstraint)0;
    c.bodyA = a; c.bodyB = b; c.p = p; c.normal = normal; c.penetration = penetration;
    _ContactConstraints[index] = c;
}

[numthreads(64,1,1)]
void BuildContacts(uint3 id : SV_DispatchThreadID)
{
    uint myID = id.x;
    if (myID >= _Count) return;
    float3 myPos = _Positions[myID];
    float4 myRot = _Rotations[myID];
    int3 myCell = ConvertCell(myPos);
    if (!IsValidCell(myCell)) return;
    for (int x = -1; x <= 1; x++)
    for (int y = -1; y <= 1; y++)
    for (int z = -1; z <= 1; z++)
    {
        int3 cell = myCell + int3(x, y, z);
        if (!IsValidCell(cell)) continue;
        uint ci = CellToIndex(cell), start = _CellStarts[ci], end = start + _CellCounts[ci];
        for (uint k = start; k < end; k++)
        {
            uint otherID = _ObjectIDs[k];
            if (otherID <= myID) continue;
            float3 otherPos = _Positions[otherID];
            float3 separation = otherPos - myPos;
            if (dot(separation, separation) > 3.0001f) continue;
            Contact c = Narrow_Phase(myPos, otherPos, myRot, _Rotations[otherID]);
            if (!c.hit) continue;
            for (uint p = 0; p < c.pointCount; p++)
                AppendContact(myID, otherID, c.points[p].pos, c.normal, c.points[p].penetration);
        }
    }
}

// All six static container planes, with a contact at each touching cube vertex.
[numthreads(64,1,1)]
void BuildFloorContacts(uint3 id : SV_DispatchThreadID)
{
    uint i = id.x;
    if (i >= _Count) return;
    float3 pos = _Positions[i];
    float4 q = _Rotations[i];
    float3 worldMax = _WorldMin + _GridSize * _CellSize;
    [unroll]
    for (uint axis = 0; axis < 3; axis++)
    for (uint side = 0; side < 2; side++)
    {
        float3 normal = 0;
        normal[axis] = side == 0 ? -1.0f : 1.0f;
        float plane = side == 0 ? _WorldMin[axis] : worldMax[axis];
        if ((pos[axis] - plane) * normal[axis] < -0.88f) continue;
        for (uint v = 0; v < 8; v++)
        {
            float3 local = float3((v & 1u) ? 0.5f : -0.5f, (v & 2u) ? 0.5f : -0.5f, (v & 4u) ? 0.5f : -0.5f);
            float3 p = pos + RotateByQuaternion(local, q);
            float depth = (p[axis] - plane) * normal[axis];
            if (depth >= -0.01f) AppendContact(i, FLOOR_BODY, p - normal * depth * 0.5f, normal, depth);
        }
    }
}

[numthreads(64,1,1)]
void ClearContactHeads(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _Count) return;
    _BodyContactHeads[id.x] = FLOOR_BODY;
    _BodyContactCounts[id.x] = 0;
}

[numthreads(1,1,1)]
void FinalizeContacts(uint3 id : SV_DispatchThreadID)
{
    uint groups = max(1u, (min(_ContactCount[0], _MaxContacts) + 63u) / 64u);
    _DispatchArgs.Store3(0, uint3(min(groups, 65535u), (groups + 65534u) / 65535u, 1));
}

[numthreads(64,1,1)]
void BuildContactLinks(uint3 id : SV_DispatchThreadID)
{
    uint i = id.x + id.y * 65535u * 64u;
    if (i >= min(_ContactCount[0], _MaxContacts)) return;
    ContactConstraint c = _ContactConstraints[i];
    uint previous;
    InterlockedExchange(_BodyContactHeads[c.bodyA], i, previous);
    _ContactNextA[i] = previous;
    InterlockedAdd(_BodyContactCounts[c.bodyA], 1);
    if (c.bodyB == FLOOR_BODY) { _ContactNextB[i] = FLOOR_BODY; return; }
    InterlockedExchange(_BodyContactHeads[c.bodyB], i, previous);
    _ContactNextB[i] = previous;
    InterlockedAdd(_BodyContactCounts[c.bodyB], 1);
}

float EffectiveMass(float3 rA, float3 rB, float3 axis, bool isStatic)
{
    float3 a = cross(rA, axis), b = cross(rB, axis);
    return 1.0f + 6.0f * dot(a, a) + (isStatic ? 0.0f : 1.0f + 6.0f * dot(b, b));
}

[numthreads(64,1,1)]
void SolveContactImpulses(uint3 id : SV_DispatchThreadID)
{
    uint i = id.x + id.y * 65535u * 64u;
    if (i >= min(_ContactCount[0], _MaxContacts)) return;
    ContactConstraint c = _ContactConstraints[i];
    bool isStatic = c.bodyB == FLOOR_BODY;
    float3 rA = c.p - _Positions[c.bodyA], rB = 0;
    float3 vA = _Velocities[c.bodyA] + cross(_AngularVelocities[c.bodyA], rA);
    float3 vB = 0;
    uint degree = _BodyContactCounts[c.bodyA];
    if (!isStatic)
    {
        rB = c.p - _Positions[c.bodyB];
        vB = _Velocities[c.bodyB] + cross(_AngularVelocities[c.bodyB], rB);
        degree = max(degree, _BodyContactCounts[c.bodyB]);
    }
    float3 relativeVelocity = vB - vA;
    float vn = dot(relativeVelocity, c.normal);
    // Degree-dependent under-relaxation bounds simultaneous Jacobi updates in dense manifolds.
    float relaxation = 1.0f / max(1u, degree);
    if (_SolverIteration == 0)
    {
        float bias = min(2.0f, 0.2f * max(c.penetration - 0.003f, 0) / _DeltaTime);
        if (c.penetration < 0) bias = c.penetration / _DeltaTime;
        float bounce = vn < -1.0f && c.penetration >= 0 ? -_Restitution * vn : 0;
        c.targetVelocity = max(bias, bounce);
        if (c.penetration < 0) c.targetVelocity = bias;
    }
    float oldNormal = c.accumulatedNormalImpulse;
    float normalImpulse = max(0, oldNormal + relaxation * (c.targetVelocity - vn) / EffectiveMass(rA, rB, c.normal, isStatic));
    float3 oldTangent = c.accumulatedTangentImpulse;
    float3 tangentVelocity = relativeVelocity - vn * c.normal;
    float tangentSpeed = length(tangentVelocity);
    float3 tangentImpulse = oldTangent;
    if (tangentSpeed > 1e-6f)
    {
        float3 tangent = tangentVelocity / tangentSpeed;
        tangentImpulse -= relaxation * tangentVelocity / EffectiveMass(rA, rB, tangent, isStatic);
    }
    float frictionLimit = _Friction * normalImpulse;
    tangentImpulse *= min(1.0f, frictionLimit / max(length(tangentImpulse), 1e-8f));
    c.accumulatedNormalImpulse = normalImpulse;
    c.accumulatedTangentImpulse = tangentImpulse;
    _ContactConstraints[i] = c;
    _ContactDeltaImpulses[i] = (normalImpulse - oldNormal) * c.normal + tangentImpulse - oldTangent;
}

[numthreads(64,1,1)]
void ApplyContactImpulses(uint3 id : SV_DispatchThreadID)
{
    uint body = id.x;
    if (body >= _Count) return;
    float3 deltaV = 0, deltaW = 0;
    uint i = _BodyContactHeads[body];
    while (i != FLOOR_BODY)
    {
        ContactConstraint c = _ContactConstraints[i];
        bool isA = c.bodyA == body;
        float3 impulse = _ContactDeltaImpulses[i] * (isA ? -1.0f : 1.0f);
        deltaV += impulse;
        deltaW += 6.0f * cross(c.p - _Positions[body], impulse);
        i = isA ? _ContactNextA[i] : _ContactNextB[i];
    }
    _NextVelocities[body] = _Velocities[body] + deltaV;
    _NextAngularVelocities[body] = _AngularVelocities[body] + deltaW;
}

[numthreads(64,1,1)]
void main(uint3 id : SV_DispatchThreadID)
{
    uint i = id.x;
    if (i >= _Count) return;
    float3 v = _Velocities[i], w = _AngularVelocities[i] / (1 + _AngularDamping * _DeltaTime);
    // This is a discrete solver, not CCD. Bound per-step displacement and spin.
    v *= min(1.0f, 30.0f / max(length(v), 1e-6f));
    w *= min(1.0f, 20.0f / max(length(w), 1e-6f));
    float4 q = IntegrateRotation(_Rotations[i], w, _DeltaTime);
    // Split positional stabilization: correct overlap without injecting kinetic energy.
    // Constraints use the pre-integration snapshot; each thread writes only its own body.
    float3 correction = 0;
    uint contactID = _ReadHeads[i], pointCount = 0;
    while (contactID != FLOOR_BODY)
    {
        ContactConstraint c = _ReadContacts[contactID];
        bool isA = c.bodyA == i;
        float massShare = c.bodyB == FLOOR_BODY ? 1.0f : 0.5f;
        correction += (isA ? -c.normal : c.normal) * max(c.penetration - 0.003f, 0) * massShare;
        pointCount++;
        contactID = isA ? _ReadNextA[contactID] : _ReadNextB[contactID];
    }
    correction *= 0.8f / max(1u, pointCount);
    correction *= min(1.0f, 0.2f / max(length(correction), 1e-6f));
    float3 p = _Positions[i] + v * _DeltaTime + correction;
    if (!all(isfinite(p)) || !all(isfinite(q)) || !all(isfinite(v)) || !all(isfinite(w)))
    {
        InterlockedAdd(_ContactCount[3], 1);
        p = float3(100, 100, 100); q = float4(0,0,0,1); v = 0; w = 0;
    }
    float3 extents = 0.5f * (abs(RotateByQuaternion(float3(1,0,0), q)) +
        abs(RotateByQuaternion(float3(0,1,0), q)) + abs(RotateByQuaternion(float3(0,0,1), q)));
    float3 lo = _WorldMin + extents, hi = _WorldMin + _GridSize * _CellSize - extents;
    // Safety projection keeps bodies in the grid even on capacity overflow/large impact.
    [unroll]
    for (uint axis = 0; axis < 3; axis++)
    {
        if (p[axis] < lo[axis] || p[axis] > hi[axis])
        {
            InterlockedAdd(_ContactCount[2], 1);
            if ((p[axis] < lo[axis] && v[axis] < 0) || (p[axis] > hi[axis] && v[axis] > 0))
                v[axis] *= -_Restitution;
            p[axis] = clamp(p[axis], lo[axis], hi[axis]);
        }
    }
    _Positions[i] = p; _Rotations[i] = q;
    _NextVelocities[i] = v; _NextAngularVelocities[i] = w;
}