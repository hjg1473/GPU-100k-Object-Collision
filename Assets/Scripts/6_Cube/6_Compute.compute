
#pragma kernel main

#pragma kernel ClearCellCounts
#pragma kernel ClearCellWriteCounters
#pragma kernel UpdateCellCounts
#pragma kernel UpdateObjectIDs
#pragma kernel UpdateCellStarts
#pragma kernel InclusiveToExclusive

#pragma kernel CalculateVelocity;

float _DeltaTime;

uint _Count;
float _CellSize;
float3 _WorldMin;
uint _GridSize;

RWStructuredBuffer<float3> _Positions;
RWStructuredBuffer<uint> _Collisions;

RWStructuredBuffer<uint> _CellCounts;
RWStructuredBuffer<uint> _ObjectIDs;
RWStructuredBuffer<uint> _CellStarts;

RWStructuredBuffer<uint> _CellWriteCounters;

StructuredBuffer<uint> _PrefixInput;
RWStructuredBuffer<uint> _PrefixOutput;

StructuredBuffer<float3> _Velocities;
RWStructuredBuffer<float3> _NextVelocities;

uint _Offset;

float Random(uint seed)
{
    return frac(sin(seed) * 12345.6789);
}

int3 ConvertCell(float3 pos)
{
    return (int3)floor((pos - _WorldMin) / _CellSize);
}

uint CellToIndex(int3 cell)
{
    return cell.x + cell.y * _GridSize + cell.z * _GridSize * _GridSize;
}

bool IsValidCell(int3 cell)
{
    return cell.x >= 0 && cell.x < (int)_GridSize &&
           cell.y >= 0 && cell.y < (int)_GridSize &&
           cell.z >= 0 && cell.z < (int)_GridSize;
}

float3 ResolveBoundaryVelocity(float3 pos, float3 velocity)
{
    float3 worldMin = _WorldMin;
    float3 worldMax = _WorldMin + _GridSize * _CellSize;

    if (pos.x <= worldMin.x && velocity.x < 0) velocity.x *= -1;
    if (pos.x >= worldMax.x && velocity.x > 0) velocity.x *= -1;
    
    if (pos.y <= worldMin.y && velocity.y < 0) velocity.y *= -1;
    if (pos.y >= worldMax.y && velocity.y > 0) velocity.y *= -1;

    if (pos.z <= worldMin.z && velocity.z < 0) velocity.z *= -1;
    if (pos.z >= worldMax.z && velocity.z > 0) velocity.z *= -1;

    return velocity;
}

float3 ResolveCollision(float3 myPos, float3 myVelocity, float3 otherPos, float3 otherVelocity)
{
    float3 delta = myPos - otherPos;
    float distSq = dot(delta, delta);

    if (distSq < 0.000001f) return myVelocity;

    float3 normal = delta * rsqrt(distSq);

    float3 relativeVelocity = myVelocity - otherVelocity;
    
    float velocityAlongNormal = dot(relativeVelocity, normal);

    if (velocityAlongNormal >= 0.0f) return myVelocity;

    float restitution = 0.8f; // 탄성계수

    float invMassA = 1.0f; // 질량 1
    float invMassB = 1.0f; 

    float j = -(1.0f + restitution) * velocityAlongNormal / (invMassA + invMassB);

    float3 impulse = j * normal;

    float3 newVelocity = myVelocity + impulse * invMassA;

    return newVelocity;
}

// Uniform-Grid Collision Detection & Caculate Velocity
float3 CalculateCollisionVelocity(uint objectID, float3 myPos, float3 myVelocity)
{
    int3 myCell = ConvertCell(myPos);

    if (!IsValidCell(myCell)) return myVelocity;

    float3 newVelocity = myVelocity;

    for (int x = -1; x <= 1; x++) {
        for (int y = -1; y <= 1; y++) {
            for (int z = -1; z <= 1; z++) {
                
                int3 neighborCell = myCell + int3(x, y, z);                

                if (!IsValidCell(neighborCell)) continue;
                
                uint neighborIdx = CellToIndex(neighborCell);

                uint cnt = _CellCounts[neighborIdx];
                uint start = _CellStarts[neighborIdx];

                for (uint k = start; k < start + cnt; k++)
                {
                    uint neighborObjectID = _ObjectIDs[k];  

                    if (neighborObjectID == objectID) continue;

                    float3 neighborPos = _Positions[neighborObjectID];

                    float3 delta = myPos - neighborPos;

                    if (dot(delta, delta) < 1.2f * 1.2f) {
                        
                        float3 neighborVelocity = _Velocities[neighborObjectID];

                        newVelocity = ResolveCollision(myPos, newVelocity, neighborPos, neighborVelocity);
                    }
                }
            }
        }
    }

    return newVelocity;
}

[numthreads(64,1,1)]
void ClearCellCounts(uint3 id : SV_DispatchThreadID)
{
    uint cellIndex = id.x;
    uint cellRange = _GridSize * _GridSize * _GridSize;

    if (cellIndex >= cellRange) return;

    _CellCounts[cellIndex] = 0;
}

[numthreads(64,1,1)]
void ClearCellWriteCounters(uint3 id : SV_DispatchThreadID)
{
    uint cellIndex = id.x;
    uint cellRange = _GridSize * _GridSize * _GridSize;

    if (cellIndex >= cellRange) return;

    _CellWriteCounters[cellIndex] = 0;
}

[numthreads(64,1,1)]
void UpdateCellCounts(uint3 id : SV_DispatchThreadID)
{
    uint objectID = id.x;

    if (objectID >= _Count) return;
    
    float3 pos = _Positions[objectID];
    int3 cell = ConvertCell(pos);

    if (!IsValidCell(cell)) return;

    uint cellIndex = CellToIndex(cell);

    InterlockedAdd(_CellCounts[cellIndex], 1);
}

[numthreads(64,1,1)]
void UpdateObjectIDs(uint3 id : SV_DispatchThreadID)
{
    uint objectID = id.x;
    if (objectID >= _Count) return;

    float3 pos = _Positions[objectID];

    int3 cell = ConvertCell(pos);
    
    if (!IsValidCell(cell)) return;

    uint cellIndex = CellToIndex(cell);

    uint localIdx;
    InterlockedAdd(_CellWriteCounters[cellIndex], 1, localIdx);

    uint idx = _CellStarts[cellIndex] + localIdx; 

    _ObjectIDs[idx] = objectID;
}

[numthreads(64,1,1)]
void UpdateCellStarts(uint3 id : SV_DispatchThreadID)
{
    uint cellIndex = id.x;
    uint cellRange = _GridSize * _GridSize * _GridSize;

    if (cellIndex >= cellRange) return;

    uint value = _PrefixInput[cellIndex];

    if (cellIndex >= _Offset)
        value += _PrefixInput[cellIndex - _Offset]; // 자기 자신 + offset만큼 앞의 거를 더함.
    
    _PrefixOutput[cellIndex] = value;
}

[numthreads(64,1,1)]
void InclusiveToExclusive(uint3 id : SV_DispatchThreadID)
{
    uint cellIndex = id.x;
    uint cellRange = _GridSize * _GridSize * _GridSize;

    if (cellIndex >= cellRange) return;
    
    if (cellIndex == 0) _CellStarts[0] = 0;
    else _CellStarts[cellIndex] = _PrefixInput[cellIndex-1];
}

[numthreads(64,1,1)]
void CalculateVelocity(uint3 id : SV_DispatchThreadID)
{
    uint objectID = id.x;

    if (objectID >= _Count) return;

    float3 myPos = _Positions[objectID];
    float3 myVelocity = _Velocities[objectID];

    myVelocity += float3(0, -9.81f, 0) * _DeltaTime;
    
    float3 newVelocity = CalculateCollisionVelocity(objectID, myPos, myVelocity);
    newVelocity = ResolveBoundaryVelocity(myPos, newVelocity);

    _NextVelocities[objectID] = newVelocity;
}


[numthreads(64,1,1)]
void main (uint3 id : SV_DispatchThreadID)
{    
    uint objectID = id.x;

    if (objectID >= _Count) return;

    // Rigidbody
    _Positions[objectID] += _Velocities[objectID] * _DeltaTime;
}
